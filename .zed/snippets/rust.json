{
  "Codeforces problem": {
    "prefix": "cf",
    "description": "Codeforces solution: solve(input, out) reading lines + main + tests",
    "body": [
      "//! ${1:71A} - ${2:Problem Name}",
      "//!",
      "//! Ref: https://codeforces.com/problemset/problem/${3:71/A}",
      "",
      "use std::io::{self, BufRead, BufWriter, Write};",
      "",
      "pub fn solve<R: BufRead, W: Write>(input: R, mut out: W) {",
      "    let mut lines = input.lines().map(|line| line.unwrap());",
      "    let ${4:n}: ${5:usize} = lines.next().unwrap().trim().parse().unwrap();",
      "    $0",
      "}",
      "",
      "fn main() {",
      "    let stdin = io::stdin();",
      "    let stdout = io::stdout();",
      "    solve(stdin.lock(), BufWriter::new(stdout.lock()));",
      "}",
      "",
      "#[cfg(test)]",
      "mod tests {",
      "    use super::*;",
      "",
      "    fn run(input: &str) -> String {",
      "        let mut out = Vec::new();",
      "        solve(input.as_bytes(), &mut out);",
      "        String::from_utf8(out).unwrap()",
      "    }",
      "",
      "    #[test]",
      "    fn test_case_1() {",
      "        assert_eq!(run(\"${6:input}\\\\n\"), \"${7:output}\\\\n\");",
      "    }",
      "}",
      ""
    ]
  },
  "Codeforces test case": {
    "prefix": "cft",
    "description": "Codeforces sample test case",
    "body": [
      "#[test]",
      "fn ${1:test_case_2}() {",
      "    assert_eq!(run(\"${2:input}\\\\n\"), \"${3:output}\\\\n\");",
      "}"
    ]
  },
  "Next line as String": {
    "prefix": "nl",
    "description": "Take the next input line as a String",
    "body": ["let ${1:line} = lines.next().unwrap();"]
  },
  "Parse next line": {
    "prefix": "nx",
    "description": "Parse the next input line as one value",
    "body": [
      "let ${1:x}: ${2:i64} = lines.next().unwrap().trim().parse().unwrap();"
    ]
  },
  "Parse next line into Vec": {
    "prefix": "nxv",
    "description": "Parse the whitespace-separated values of the next input line into a Vec",
    "body": [
      "let ${1:a}: Vec<${2:i64}> = lines",
      "    .next()",
      "    .unwrap()",
      "    .split_ascii_whitespace()",
      "    .map(|x| x.parse().unwrap())",
      "    .collect();"
    ]
  }
}
