{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "cf: test current problem",
      "type": "shell",
      "command": "cargo",
      "args": ["test", "--bin", "${fileBasenameNoExtension}"],
      "problemMatcher": ["$rustc"],
      "group": { "kind": "test", "isDefault": true }
    },
    {
      "label": "cf: run current problem",
      "type": "shell",
      "command": "cargo",
      "args": ["run", "--quiet", "--bin", "${fileBasenameNoExtension}"],
      "problemMatcher": ["$rustc"],
      "presentation": { "focus": true }
    }
  ]
}
